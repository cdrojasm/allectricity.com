SPAT_ENVIRONMENT=local
SPAT_API_PORT=18000
SPAT_MAIL_PORT=18025
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ACCESS_KEY=__MINIO_ACCESS_KEY__
MINIO_SECRET_KEY=__MINIO_SECRET_KEY__
MINIO_PUBLIC_ENDPOINT=localhost:19000
POSTGRES_DB=spat
POSTGRES_USER=spat
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
DATABASE_URL=postgresql+psycopg://spat:${POSTGRES_PASSWORD}@postgres:5432/spat
AUTH_JWT_SECRET=__JWT_SECRET__
AUTH_JWT_ISSUER=spat-api
AUTH_JWT_AUDIENCE=spat-workspace
AUTH_ACCESS_SECONDS=900
AUTH_REFRESH_SECONDS=2592000
AUTH_RESET_SECONDS=1800
AUTH_MAIL_ENCRYPTION_KEY=__MAIL_KEY__
AUTH_RESET_URL=http://localhost:3000/reset-password
GOOGLE_CLIENT_ID=
CELERY_BROKER_URL=redis://redis:6379/0
MINIO_WEBHOOK_AUTH_TOKEN=__MINIO_WEBHOOK_TOKEN__
NEO4J_USER=neo4j
NEO4J_PASSWORD=__NEO4J_PASSWORD__
NEO4J_HTTP_PORT=17474
NEO4J_BOLT_PORT=17687
DOCUMENT_AGENTS_ENABLED=auto
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_CACHE_SECONDS=300
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
DOCUMENT_EXTRACTOR_PROMPT_NAME=spat-document-extractor
DOCUMENT_EXTRACTOR_PROMPT_VERSION=
DOCUMENT_CONSOLIDATOR_PROMPT_NAME=spat-document-consolidator
DOCUMENT_CONSOLIDATOR_PROMPT_VERSION=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_FROM=SPAT <noreply@spat.local>
SMTP_USERNAME=
SMTP_PASSWORD=
