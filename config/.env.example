SPAT_ENVIRONMENT=local
SPAT_FRONTEND_PORT=3001
MINIO_ACCESS_KEY=__MINIO_ACCESS_KEY__
MINIO_SECRET_KEY=__MINIO_SECRET_KEY__
POSTGRES_DB=spat
POSTGRES_USER=spat
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
DATABASE_URL=postgresql+psycopg://spat:${POSTGRES_PASSWORD}@postgres:5432/spat
AUTH_JWT_SECRET=__JWT_SECRET__
AUTH_JWT_ISSUER=spat-api
AUTH_JWT_AUDIENCE=spat-workspace
AUTH_ACCESS_SECONDS=900
# Ventana móvil de inactividad antes de exigir un nuevo inicio de sesión (30 días por defecto).
AUTH_REFRESH_SECONDS=2592000
AUTH_RESET_SECONDS=1800
AUTH_MAIL_ENCRYPTION_KEY=__MAIL_KEY__
AUTH_RESET_URL=http://localhost:3001/reset-password
GOOGLE_CLIENT_ID=
CELERY_BROKER_URL=redis://redis:6379/0
# Upload recovery: queue pending files after 5 min, recover scans after 45 min,
# expire incomplete uploads after 24 h and clean quarantine objects after 30 days.
UPLOAD_PENDING_RECOVERY_SECONDS=300
UPLOAD_QUEUED_STALE_SECONDS=1200
UPLOAD_SCAN_STALE_SECONDS=2700
UPLOAD_ORPHAN_EXPIRY_SECONDS=86400
UPLOAD_QUARANTINE_RETENTION_SECONDS=2592000
UPLOAD_MAX_ATTEMPTS=10
MINIO_WEBHOOK_AUTH_TOKEN=__MINIO_WEBHOOK_TOKEN__
OCR_INTERNAL_API_TOKEN=__OCR_INTERNAL_TOKEN__
OCR_PROVIDER=tesseract
NEO4J_USER=neo4j
NEO4J_PASSWORD=__NEO4J_PASSWORD__
DOCUMENT_AGENTS_ENABLED=auto
PHOENIX_ENDPOINT=http://localhost:6006
PHOENIX_PROMPT_TAG=production
# LLM: OpenRouter is the only provider. Models are `<provider>/<model>` (a bare name gets `openai/`).
# OPENROUTER_BASE_URL is only for pointing at a local stub in smoke tests; leave it empty.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1
OPENROUTER_BASE_URL=
# Design agent: iterations of "Optimizar hasta cumplir", and token budget control.
DESIGN_MAX_ITERATIONS=3
# true = an account without an active token budget cannot use the agent (recommended for external pilots).
AGENT_REQUIRE_BUDGET=false
# Tokens a budget must still have for the agent to start a step.
AGENT_MIN_STEP_TOKENS=2000
# Material search: Tavily when set; otherwise OpenRouter's openrouter:web_search.
TAVILY_API_KEY=
# Optional Tavily-compatible endpoint override for controlled deployments.
MATERIAL_CATALOG_SEARCH_URL=https://api.tavily.com/search
# Every LLM call is a unit of work (backend/src/infrastructure/agents/uow.py) named after its Phoenix prompt
# (spat-agent-orchestrator, spat-study-writer, ...): prompt, model and temperature are edited in Phoenix.
# Pin one version with <APPLICATION>_PROMPT_VERSION, e.g. DOCUMENT_EXTRACTOR_PROMPT_VERSION.
DOCUMENT_EXTRACTOR_PROMPT_VERSION=
DOCUMENT_CONSOLIDATOR_PROMPT_VERSION=
# Traces of every unit of work go to Phoenix (project below); PHOENIX_TRACING=false switches them off.
PHOENIX_PROJECT_NAME=allectricity
PHOENIX_TRACING=true
# Precio del modelo en USD por millón de tokens; vacío = no se estima coste.
LLM_PRICE_INPUT_USD_PER_MTOK=
LLM_PRICE_OUTPUT_USD_PER_MTOK=
# Límites de tokens LLM de la extracción documental; 0 = sin límite.
DOCUMENT_LLM_MAX_TOKENS_PER_FILE=400000
DOCUMENT_LLM_MAX_TOKENS_PER_PROJECT=0
PDF_OCR_MAX_PAGES=50
PDF_OCR_DPI=200
PDF_TABLE_MAX_PAGES=200
# Envío de correos: smtp (local, Mailpit) o resend (API HTTPS; Railway bloquea el SMTP saliente fuera de Pro).
MAIL_PROVIDER=smtp
# Solo con MAIL_PROVIDER=resend. MAIL_FROM debe ser de un dominio verificado en Resend (si falta se usa SMTP_FROM).
RESEND_API_KEY=
MAIL_FROM=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_FROM=SPAT <noreply@spat.local>
SMTP_USERNAME=
SMTP_PASSWORD=
# Mercado Pago. Naming: MP_<TEST|PROD>_<THING> for credentials, MP_PLAN_* for the tiers.
# Credentials: Tus integraciones → Credenciales de prueba / de producción. Webhook secret: Webhooks →
# Configurar notificaciones ("clave secreta"). An empty secret disables that mode's webhook (503).
MP_MODE=test
MP_TEST_ACCESS_TOKEN=
MP_TEST_PUBLIC_KEY=
MP_TEST_WEBHOOK_SECRET=
MP_PROD_ACCESS_TOKEN=
MP_PROD_PUBLIC_KEY=
MP_PROD_WEBHOOK_SECRET=
# Tiers, comma-separated and aligned by position (same length, same order).
MP_PLAN_NAMES=ultimate,standard,essentials
MP_PLAN_IDS=
MP_PLAN_PRICES_USD=199,49,19
MP_PLAN_MONTHLY_TOKENS=30000000,8000000,3000000
# The test seller cannot see production plans: create copies with scripts/create_mp_test_plans.py.
MP_TEST_PLAN_IDS=
# Who can buy while MP_MODE=test: admins (default; the public test cards would otherwise give away tokens) or
# everyone (local development). Production mode refuses credentials of a Mercado Pago test account.
MP_TEST_CHECKOUT=everyone
# Failed charge: days of access before suspension. Minimum days between two budget resets.
MP_GRACE_DAYS=7
MP_RESET_MIN_DAYS=20
