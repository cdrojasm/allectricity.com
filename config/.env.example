SPAT_ENVIRONMENT=local
SPAT_API_PORT=18000
SPAT_FRONTEND_PORT=3000
SPAT_MAIL_PORT=18025
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ACCESS_KEY=__MINIO_ACCESS_KEY__
MINIO_SECRET_KEY=__MINIO_SECRET_KEY__
MINIO_PUBLIC_ENDPOINT=localhost:19000
POSTGRES_DB=spat
POSTGRES_USER=spat
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
DATABASE_URL=postgresql+psycopg://spat:${POSTGRES_PASSWORD}@postgres:5432/spat
AUTH_JWT_SECRET=__JWT_SECRET__
AUTH_JWT_ISSUER=spat-api
AUTH_JWT_AUDIENCE=spat-workspace
AUTH_ACCESS_SECONDS=900
AUTH_REFRESH_SECONDS=2592000
AUTH_RESET_SECONDS=1800
AUTH_MAIL_ENCRYPTION_KEY=__MAIL_KEY__
AUTH_RESET_URL=http://localhost:3000/reset-password
GOOGLE_CLIENT_ID=
CELERY_BROKER_URL=redis://redis:6379/0
# Upload recovery: queue pending files after 5 min, recover scans after 45 min,
# expire incomplete uploads after 24 h and clean quarantine objects after 30 days.
UPLOAD_PENDING_RECOVERY_SECONDS=300
UPLOAD_QUEUED_STALE_SECONDS=1200
UPLOAD_SCAN_STALE_SECONDS=2700
UPLOAD_ORPHAN_EXPIRY_SECONDS=86400
UPLOAD_QUARANTINE_RETENTION_SECONDS=2592000
UPLOAD_MAX_ATTEMPTS=10
MINIO_WEBHOOK_AUTH_TOKEN=__MINIO_WEBHOOK_TOKEN__
OCR_INTERNAL_API_TOKEN=__OCR_INTERNAL_TOKEN__
OCR_PROVIDER=tesseract
NEO4J_USER=neo4j
NEO4J_PASSWORD=__NEO4J_PASSWORD__
NEO4J_HTTP_PORT=17474
NEO4J_BOLT_PORT=17687
DOCUMENT_AGENTS_ENABLED=auto
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_CACHE_SECONDS=300
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
DOCUMENT_EXTRACTOR_PROMPT_NAME=spat-document-extractor
DOCUMENT_EXTRACTOR_PROMPT_VERSION=
DOCUMENT_CONSOLIDATOR_PROMPT_NAME=spat-document-consolidator
DOCUMENT_CONSOLIDATOR_PROMPT_VERSION=
# Precio del modelo en USD por millón de tokens; vacío = no se estima coste.
LLM_PRICE_INPUT_USD_PER_MTOK=
LLM_PRICE_OUTPUT_USD_PER_MTOK=
# Límites de tokens LLM de la extracción documental; 0 = sin límite.
DOCUMENT_LLM_MAX_TOKENS_PER_FILE=400000
DOCUMENT_LLM_MAX_TOKENS_PER_PROJECT=0
PDF_OCR_MAX_PAGES=50
PDF_OCR_DPI=200
PDF_TABLE_MAX_PAGES=200
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_FROM=SPAT <noreply@spat.local>
SMTP_USERNAME=
SMTP_PASSWORD=
