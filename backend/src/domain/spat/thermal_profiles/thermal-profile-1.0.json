{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thermal sizing profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "standard", "edition", "equation_form", "reference",
               "default_ambient_c", "materials", "aliases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "standard": {"type": "string", "minLength": 1},
    "edition": {"type": "string", "minLength": 1},
    "equation_form": {"const": "tcap"},
    "reference": {"type": "string", "minLength": 1},
    "default_ambient_c": {"type": "number", "minimum": -50, "maximum": 200},
    "aliases": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "materials": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/material"}}
  },
  "$defs": {
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "conductivity_pct", "alpha_r", "k0_c", "resistivity_micro_ohm_cm",
                   "tcap_j_cm3_c", "tcap_printed_j_cm3_c", "fusion_temp_c", "source", "published_kf"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 60},
        "name": {"type": "string", "minLength": 1},
        "conductivity_pct": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "alpha_r": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.01},
        "k0_c": {"type": "number", "exclusiveMinimum": 0, "maximum": 2000},
        "resistivity_micro_ohm_cm": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
        "tcap_j_cm3_c": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "tcap_printed_j_cm3_c": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "fusion_temp_c": {"type": "number", "exclusiveMinimum": 0, "maximum": 4000},
        "source": {"type": "string", "minLength": 1},
        "notes": {"type": "string"},
        "published_kf": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["tm_c", "value", "source", "status"],
            "properties": {
              "tm_c": {"type": "number", "exclusiveMinimum": 0},
              "value": {"type": "number", "exclusiveMinimum": 0},
              "source": {"type": "string", "minLength": 1},
              "status": {"enum": ["consistent", "stale_in_norm"]}
            }
          }
        }
      }
    }
  }
}
