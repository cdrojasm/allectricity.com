{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thermal sizing profile, tabulated Kf form",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "standard",
    "edition",
    "equation_form",
    "reference",
    "issuing_act",
    "default_ambient_c",
    "area_divisor_kcmil_per_mm2",
    "voltage_levels",
    "materials"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "standard": {
      "type": "string",
      "minLength": 1
    },
    "edition": {
      "type": "string",
      "minLength": 1
    },
    "equation_form": {
      "const": "kf"
    },
    "reference": {
      "type": "string",
      "minLength": 1
    },
    "issuing_act": {
      "type": "string",
      "minLength": 1
    },
    "default_ambient_c": {
      "type": "number",
      "minimum": -50,
      "maximum": 200
    },
    "area_divisor_kcmil_per_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "voltage_levels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "low",
        "medium_high_extra_high"
      ],
      "properties": {
        "low": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "equation",
            "delegates_to"
          ],
          "properties": {
            "equation": {
              "type": "string",
              "minLength": 1
            },
            "delegates_to": {
              "type": "string",
              "minLength": 1
            },
            "alternative": {
              "type": "string"
            }
          }
        },
        "medium_high_extra_high": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "equation",
            "table"
          ],
          "properties": {
            "equation": {
              "type": "string",
              "minLength": 1
            },
            "table": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "conductivity_pct",
          "tm_c",
          "kf",
          "source",
          "ieee80_2013_material_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "maxLength": 60
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "conductivity_pct": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100
          },
          "tm_c": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 4000
          },
          "kf": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100
          },
          "joint_type": {
            "enum": [
              "exothermic",
              "mechanical"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "ieee80_2013_material_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
