FROM gcc:14-bookworm AS build
WORKDIR /build
COPY services/potential_engine/src/main.cpp ./main.cpp
RUN g++ -std=c++17 -O3 -Wall -Wextra -Wpedantic main.cpp -o /spat-potential-engine \
    && strip --strip-unneeded /spat-potential-engine

FROM python:3.12-slim
RUN useradd --create-home --uid 10003 engine
COPY --from=build /spat-potential-engine /usr/local/bin/spat-potential-engine
COPY services/potential_engine/server.py services/potential_engine/solver_api.py /app/
USER engine
WORKDIR /app
ENV SPAT_POTENTIAL_ENGINE=/usr/local/bin/spat-potential-engine PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
EXPOSE 8080
CMD ["python", "solver_api.py"]
