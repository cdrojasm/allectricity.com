# Required service variables. Define secrets in Railway Variables, never commit them.
SPAT_ENVIRONMENT=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
CELERY_BROKER_URL=${{Redis.REDIS_URL}}
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_JWT_ISSUER=spat-api
AUTH_JWT_AUDIENCE=spat-workspace
AUTH_MAIL_ENCRYPTION_KEY=replace-with-fernet-key
AUTH_RESET_URL=https://your-frontend-domain/reset-password
POSTGRES_DB=spat
POSTGRES_USER=spat
POSTGRES_PASSWORD=replace-in-database-service
NEO4J_URI=bolt://neo4j.railway.internal:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-in-neo4j-service
MINIO_ENDPOINT=minio.railway.internal:9000
MINIO_ACCESS_KEY=replace-in-minio-service
MINIO_SECRET_KEY=replace-in-minio-service
MINIO_SECURE=false
MINIO_WEBHOOK_AUTH_TOKEN=replace-with-random-token
OCR_INTERNAL_API_TOKEN=replace-with-random-token
SPAT_POTENTIAL_ENGINE_URL=http://potential-engine.railway.internal:8080
OCR_SERVICE_URL=http://ocr.railway.internal:8080
CLAMAV_HOST=clamav.railway.internal
# Railway blocks outbound SMTP below the Pro plan: mail goes through Resend's HTTPS API.
MAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-resend-key
# Must belong to a domain verified in Resend (onboarding@resend.dev only reaches the account owner).
MAIL_FROM=Allectricity <no-reply@your-domain>
PUBLIC_APP_URL=https://your-frontend-domain
# Google sign-in: public OAuth Web client ID (origin https://app.<domain> authorized). No client secret.
GOOGLE_CLIENT_ID=replace-with-client-id.apps.googleusercontent.com
PHOENIX_ENDPOINT=http://phoenix.railway.internal:6006
PHOENIX_PROMPT_TAG=production
PHOENIX_PROJECT_NAME=allectricity
# Design agent: iterations of "Optimizar hasta cumplir", and token budget control.
DESIGN_MAX_ITERATIONS=3
# true = an account without an active token budget cannot use the agent (recommended for external pilots).
AGENT_REQUIRE_BUDGET=true
# Tokens a budget must still have for the agent to start a step.
AGENT_MIN_STEP_TOKENS=2000
# Mercado Pago (Tus integraciones → tu aplicación). Webhook URLs to register in Webhooks → Configurar notificaciones:
#   Modo de prueba:  https://your-frontend-domain/api/v1/billing/mercadopago/webhooks/test
#   Modo productivo: https://your-frontend-domain/api/v1/billing/mercadopago/webhooks/prod
# Events: "Planes y suscripciones" and "Pagos". The secret is the "clave secreta" shown after saving.
MP_TEST_ACCESS_TOKEN=replace-with-TEST-access-token
MP_TEST_WEBHOOK_SECRET=replace-with-webhook-secret
MP_PROD_ACCESS_TOKEN=replace-with-APP_USR-access-token
MP_PROD_WEBHOOK_SECRET=replace-with-webhook-secret
MP_MODE=prod
MP_TEST_PUBLIC_KEY=replace-with-test-public-key
MP_PROD_PUBLIC_KEY=replace-with-prod-public-key
MP_PLAN_NAMES=ultimate,standard,essentials
MP_PLAN_IDS=replace-with-production-plan-ids
MP_TEST_PLAN_IDS=replace-with-test-plan-ids
MP_PLAN_PRICES_USD=199,49,19
MP_PLAN_MONTHLY_TOKENS=30000000,8000000,3000000
# While MP_MODE=test only administrators can buy (test cards are public). Never set "everyone" here.
MP_TEST_CHECKOUT=admins
MP_GRACE_DAYS=7
