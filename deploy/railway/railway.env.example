# Required service variables. Define secrets in Railway Variables, never commit them.
SPAT_ENVIRONMENT=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
CELERY_BROKER_URL=${{Redis.REDIS_URL}}
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_JWT_ISSUER=spat-api
AUTH_JWT_AUDIENCE=spat-workspace
AUTH_MAIL_ENCRYPTION_KEY=replace-with-fernet-key
AUTH_RESET_URL=https://your-frontend-domain/reset-password
POSTGRES_DB=spat
POSTGRES_USER=spat
POSTGRES_PASSWORD=replace-in-database-service
NEO4J_URI=bolt://neo4j.railway.internal:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-in-neo4j-service
MINIO_ENDPOINT=minio.railway.internal:9000
MINIO_ACCESS_KEY=replace-in-minio-service
MINIO_SECRET_KEY=replace-in-minio-service
MINIO_SECURE=false
MINIO_WEBHOOK_AUTH_TOKEN=replace-with-random-token
OCR_INTERNAL_API_TOKEN=replace-with-random-token
SPAT_POTENTIAL_ENGINE_URL=http://potential-engine.railway.internal:8080
OCR_SERVICE_URL=http://ocr.railway.internal:8080
CLAMAV_HOST=clamav.railway.internal
SMTP_HOST=replace-with-smtp-provider
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_FROM=SPAT <noreply@example.com>
PUBLIC_APP_URL=https://your-frontend-domain
# Design agent: iterations of "Optimizar hasta cumplir", and token budget control.
DESIGN_MAX_ITERATIONS=3
# true = an account without an active token budget cannot use the agent (recommended for external pilots).
AGENT_REQUIRE_BUDGET=true
# Tokens a budget must still have for the agent to start a step.
AGENT_MIN_STEP_TOKENS=2000
